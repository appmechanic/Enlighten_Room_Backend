# --- Runtime ---
NODE_ENV=development
PORT=5000

# --- Security / networking ---
# Comma-separated list of allowed origins for CORS. Leave blank in dev to
# allow all; MUST be set in production (a boot warning fires otherwise).
CORS_ORIGINS=https://admin.example.com,https://class.example.com
# Requests per minute per IP against /api. Tune per traffic.
RATE_LIMIT_MAX_PER_MIN=300
# Graceful-shutdown drain window before force-exit (ms).
SHUTDOWN_TIMEOUT_MS=15000

# --- Auth / crypto ---
JWT_SECRET_KEY=
SESSION_SECRET=
INITIAL_SECRET_KEY=

# --- Database ---
DB_URL=mongodb://localhost:27017/enlighten

# --- Mail (SMTP via nodemailer / Gmail) ---
NODEMAILER_EMAIL=
NODEMAILER_PASSCODE=
CONTACT_TO=

# --- Frontends ---
FRONTEND_URL=http://localhost:5173

# --- AI providers ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Google Drive integration ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_DRIVE_SCOPE=

# --- Currency conversion (openexchangerates.org) ---
OPEN_EXCHANGE_RATES_APP_ID=

# --- Object storage (DigitalOcean Spaces / S3) ---
DO_SPACE_KEY=
DO_SPACE_SECRET=
DO_SPACE_REGION=
DO_SPACE_BUCKET=
DO_SPACE_ENDPOINT=
